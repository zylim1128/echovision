# Ignore dataset images and annotations
datasets/**/*.jpg
datasets/**/*.jpeg
datasets/**/*.png
datasets/**/*.bmp
datasets/**/*.tiff
datasets/**/*.tif
datasets/**/*.gif
datasets/**/*.webp

# Ignore dataset label files (if not needed)
datasets/**/*.txt
datasets/**/*.json
datasets/**/*.xml
datasets/**/*.csv

# Ignore temporary and cache files
datasets/**/__pycache__/
datasets/**/.DS_Store
datasets/**/Thumbs.db

# Ignore large model files (optional)
*.pt
*.pth
*.onnx
*.tflite
*.pb